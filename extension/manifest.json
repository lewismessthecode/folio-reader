{
  "manifest_version": 3,
  "name": "Folio Reader Bridge",
  "version": "0.1.0",
  "description": "Read X bookmarks for Folio without navigating your tabs",
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Folio"
  }
}
