{
  "name": "folio-reader",
  "version": "0.3.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --mac zip --arm64"
  },
  "build": {
    "appId": "local.folio.reader",
    "productName": "Folio",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "assets/Folio.icns"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ]
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.50.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  },
  "license": "Apache-2.0"
}
